# EC2 서버의 docker-compose.prod.yml과 같은 디렉터리에 이 내용을 .env로 채워서 둘 것.
# 이 파일 자체는 예시일 뿐이며 절대 실제 값으로 채워서 커밋하지 않는다.

# app <-> mysql 컨테이너 간 접속이므로 host는 서비스명(mysql)을 사용
DB_URL=jdbc:mysql://mysql:3306/ddadang
DB_USER=root
DB_PW=

MYSQL_ROOT_PASSWORD=

# --- 아이센스(i-sens) 개발자센터 앱 정보 (운영/배포용) ---
ISENS_CLIENT_ID=
ISENS_CLIENT_SECRET=
ISENS_REDIRECT_URI=https://<탄력적 IP를 -로 이은 값>.sslip.io/api/cgm/oauth/callback

# --- 카카오 디벨로퍼스 앱 정보 (웹 카카오 로그인용) ---
# REST API 키. Client Secret은 카카오 콘솔에서 사용 설정한 경우에만 채운다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# (선택) 카카오 인가 URL 발급에 허용할 redirect URI, 쉼표 구분. 비우면 application.yml 기본값(vercel, localhost:5000)
# KAKAO_ALLOWED_REDIRECT_URIS=

# --- JWT 서명 키 (32바이트 이상 랜덤 문자열, 예: openssl rand -base64 48) ---
JWT_SECRET=

# --- 사진 저장소(S3, 비공개 버킷) ---
S3_BUCKET=
AWS_REGION=ap-northeast-2
# 자격 증명은 키 대신 EC2 IAM 역할(인스턴스 프로파일)을 사용한다. DEPLOY.md 6번 참고.

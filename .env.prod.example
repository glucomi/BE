# EC2 서버의 docker-compose.prod.yml과 같은 디렉터리에 이 내용을 .env로 채워서 둘 것.
# 이 파일 자체는 예시일 뿐이며 절대 실제 값으로 채워서 커밋하지 않는다.

# app <-> mysql 컨테이너 간 접속이므로 host는 서비스명(mysql)을 사용
DB_URL=jdbc:mysql://mysql:3306/ddadang
DB_USER=root
DB_PW=

MYSQL_ROOT_PASSWORD=

# --- 아이센스(i-sens) 개발자센터 앱 정보 (운영/배포용) ---
ISENS_CLIENT_ID=
ISENS_CLIENT_SECRET=
ISENS_REDIRECT_URI=https://<EC2 도메인 또는 IP>/api/cgm/oauth/callback

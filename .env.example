# 로컬 실행용 환경변수 템플릿. 이 파일을 복사해 .env로 만들고 값을 채워 넣을 것.
# cp .env.example .env

# --- 로컬 MySQL ---
DB_URL=jdbc:mysql://localhost:3306/ddadang
DB_USER=
DB_PW=

# --- 아이센스(i-sens) 개발자센터 샌드박스 앱 정보 ---
ISENS_CLIENT_ID=
ISENS_CLIENT_SECRET=
ISENS_REDIRECT_URI=http://localhost:8080/api/cgm/oauth/callback

# --- 카카오 디벨로퍼스 앱 정보 (웹 카카오 로그인용) ---
# REST API 키. Client Secret은 카카오 콘솔에서 사용 설정한 경우에만 채운다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# (선택) 카카오 인가 URL 발급에 허용할 redirect URI, 쉼표 구분. 비우면 application.yml 기본값(vercel, localhost:5000)
# KAKAO_ALLOWED_REDIRECT_URIS=

# --- JWT 서명 키 (32바이트 이상 랜덤 문자열, 예: openssl rand -base64 48) ---
JWT_SECRET=

# --- 사진 저장소(S3, 비공개 버킷) ---
S3_BUCKET=
AWS_REGION=ap-northeast-2
# 로컬에서 S3에 올려보려면 S3 권한만 있는 IAM 사용자 키를 넣는다(루트 키 사용 금지). 비워두면 업로드만 실패한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
